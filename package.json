{
  "name": "product-hunt-clone-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the Product Hunt clone (Express, Prisma, hexagonal architecture)",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "jobs": "node dist/main/jobs.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itslucassantos/product-hunt-clone-backend.git"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "hexagonal-architecture"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Itslucassantos/product-hunt-clone-backend/issues"
  },
  "homepage": "https://github.com/Itslucassantos/product-hunt-clone-backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@clerk/express": "^2.1.75",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "svix": "^2.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
