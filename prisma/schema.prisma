generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id
  externalId String   @unique
  role       Role     @default(USER)
  votes      Vote[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id              String        @id
  title           String        @unique
  description     String
  longDescription String?
  url             String
  imageUrl        String?
  status          ProductStatus @default(PUBLISHED)
  upvotes         Int           @default(0)
  votes           Vote[]
  review          Review?
  topics          Topic[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, upvotes(sort: Desc), createdAt(sort: Desc)])
}

model Vote {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model Review {
  id        String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @unique
  rating    Int
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Topic {
  id           String             @id
  slug         String             @unique
  position     Int
  translations TopicTranslation[]
  products     Product[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([position])
}

model TopicTranslation {
  id          String  @id
  topic       Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId     String
  locale      Locale
  name        String
  description String?

  @@unique([topicId, locale])
  @@unique([locale, name])
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  PUBLISHED
  COMING_SOON
}

enum Locale {
  en
  pt_BR @map("pt-BR")
}

model ProductImage {
  id          String   @id
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}
